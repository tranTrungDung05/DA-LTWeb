@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng nhập - Smart Hostel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light d-flex align-items-center" style="height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white text-center py-3">
                        <h5 class="mb-0">HỆ THỐNG QUẢN LÝ PHÒNG TRỌ</h5>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            
                            <div class="mb-3">
                                <label class="form-label">Tài khoản</label>
                                <input type="text" name="username" class="form-control" placeholder="Tên đăng nhập" required />
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">Mật khẩu</label>
                                <input type="password" name="password" class="form-control" placeholder="Mật khẩu" required />
                            </div>
                            
                            <button type="submit" class="btn btn-primary w-100 py-2">Đăng Nhập</button>
                            
                            <div class="text-center mt-3">
                                <p class="mb-0 text-muted">Chưa có tài khoản? <a asp-action="Register" class="text-success text-decoration-none fw-bold">Đăng ký ngay</a></p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>