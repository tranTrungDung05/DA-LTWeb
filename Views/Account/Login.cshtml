@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - Smart Hostel</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <main class="auth-shell">
        <a class="auth-brand" asp-controller="Home" asp-action="Index">
            <span>
                <svg viewBox="0 0 32 32">
                    <path d="M5 15.2 16 6l11 9.2v11.3a1.5 1.5 0 0 1-1.5 1.5h-19A1.5 1.5 0 0 1 5 26.5V15.2Z" />
                    <path d="M12.2 28v-8.2h7.6V28M10.5 14.7h11" />
                </svg>
            </span>
            Smart Hostel
        </a>

        <section class="auth-card">
            <div class="auth-card__intro">
                <span class="auth-kicker">CHÀO MỪNG TRỞ LẠI</span>
                <h1>Đăng nhập để tiếp tục.</h1>
                <p>Quản lý nhà trọ hoặc kiểm tra hóa đơn của bạn trong một không gian duy nhất.</p>
            </div>

            <form asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]">
                <div asp-validation-summary="ModelOnly" class="auth-validation"></div>
                <label>
                    <span>Tài khoản</span>
                    <input type="text" name="username" placeholder="Nhập tên đăng nhập" autocomplete="username" required autofocus />
                </label>
                <label>
                    <span>Mật khẩu</span>
                    <input type="password" name="password" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                </label>
                <button type="submit">Đăng nhập</button>
            </form>

            <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
        </section>
        <p class="auth-footer">© 2026 Smart Hostel</p>
    </main>
</body>
</html>
