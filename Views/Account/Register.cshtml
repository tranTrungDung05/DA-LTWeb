@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng ký - Smart Hostel</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <main class="auth-shell">
        <a class="auth-brand" asp-controller="Home" asp-action="Index">
            <span>
                <svg viewBox="0 0 32 32">
                    <path d="M5 15.2 16 6l11 9.2v11.3a1.5 1.5 0 0 1-1.5 1.5h-19A1.5 1.5 0 0 1 5 26.5V15.2Z" />
                    <path d="M12.2 28v-8.2h7.6V28M10.5 14.7h11" />
                </svg>
            </span>
            Smart Hostel
        </a>

        <section class="auth-card auth-card--wide">
            <div class="auth-card__intro">
                <span class="auth-kicker">TẠO TÀI KHOẢN</span>
                <h1>Bắt đầu thật gọn.</h1>
                <p>Tạo tài khoản cư dân để nhận và thanh toán hóa đơn trực tuyến.</p>
            </div>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="auth-validation"></div>
                <div class="auth-grid">
                    <label>
                        <span>Tài khoản</span>
                        <input type="text" name="username" placeholder="Tên đăng nhập viết liền" autocomplete="username" required autofocus />
                    </label>
                    <label>
                        <span>Họ và tên</span>
                        <input type="text" name="fullName" placeholder="Nhập họ tên đầy đủ" autocomplete="name" required />
                    </label>
                    <label class="auth-grid__wide">
                        <span>Email</span>
                        <input type="email" name="email" placeholder="name@example.com" autocomplete="email" />
                    </label>
                    <label>
                        <span>Mật khẩu</span>
                        <input type="password" name="password" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" required />
                    </label>
                    <label>
                        <span>Nhập lại mật khẩu</span>
                        <input type="password" name="confirmPassword" placeholder="Xác nhận mật khẩu" autocomplete="new-password" required />
                    </label>
                </div>
                <button type="submit">Tạo tài khoản</button>
            </form>

            <p class="auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập ngay</a></p>
        </section>
        <p class="auth-footer">© 2026 Smart Hostel</p>
    </main>
</body>
</html>
