@model smart_hostel_management_system.Models.ViewModels.ContractFormViewModel
@{
    ViewData["Title"] = "Thêm mới hợp đồng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Thêm mới hợp đồng thuê phòng</h2>
    </div>

    <form asp-action="Create" method="post" class="card card-body shadow-sm">
        <partial name="_Form" model="Model" />
        <div class="mt-3">
            <button type="submit" class="btn btn-primary px-4">💾 Lưu hợp đồng</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Quay lại</a>
        </div>
    </form>
</div>