@model smart_hostel_management_system.Models.Core.Contract
@{
    ViewData["Title"] = "Chi tiết hợp đồng " + Model.ContractNumber;
    var detail = Model.ContractDetails.FirstOrDefault();
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">📜 Thông tin chi tiết hợp đồng: @Model.ContractNumber</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-2"><strong>Ngày lập:</strong> @Model.Date.ToString("dd/MM/yyyy")</div>
                <div class="col-md-6 mb-2"><strong>Trạng thái:</strong> <span class="badge bg-success">@Model.Status</span></div>
                <div class="col-md-6 mb-2"><strong>Người đại diện ký tên:</strong> @Model.Tenant?.FullName</div>
                <div class="col-md-6 mb-2"><strong>Phòng trọ thuê:</strong> Phòng số @(detail?.Room?.RoomNumber ?? "N/A")</div>
                <div class="col-md-6 mb-2"><strong>Ngày bắt đầu ở:</strong> @(detail?.StartDate.ToString("dd/MM/yyyy") ?? "N/A")</div>
                <div class="col-md-6 mb-2"><strong>Ngày hết hạn:</strong> @(detail?.EndDate.ToString("dd/MM/yyyy") ?? "N/A")</div>
                <div class="col-12 mb-2"><hr /><strong>Điều khoản cam kết:</strong><p class="text-muted">@Model.Note</p></div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">👥 Thành viên đang lưu trú thực tế tại phòng</h5>
            <a href="/Tenants/Create" class="btn btn-sm btn-success">+ Thêm cư dân mới ở ghép</a>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Họ và tên</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Phân quyền/Vai trò</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.Members != null && ((List<smart_hostel_management_system.Models.Core.TenantRoom>)ViewBag.Members).Count > 0)
                    {
                        foreach (var item in (List<smart_hostel_management_system.Models.Core.TenantRoom>)ViewBag.Members)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.Tenant?.FullName</td>
                                <td>@item.Tenant?.Phone</td>
                                <td>@item.Tenant?.Email</td>
                                <td>
                                    @if (item.IsRepresentative)
                                    {
                                        <span class="badge bg-danger">👑 Đại diện ký hợp đồng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">👤 Thành viên ở ghép</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-3 text-muted">Chưa cập nhật danh sách cư dân lưu trú cho phòng này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>