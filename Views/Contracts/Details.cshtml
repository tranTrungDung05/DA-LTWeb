@model smart_hostel_management_system.Models.Core.Contract
@{
    ViewData["Title"] = "Chi tiết hợp đồng " + Model.ContractNumber;
    var detail = Model.ContractDetails.FirstOrDefault();
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0 fw-bold">Thông tin chi tiết hợp đồng: @Model.ContractNumber</h4>
        </div>
        <div class="card-body bg-light">
            <div class="row g-3">
                <div class="col-md-6"><strong>Ngày lập:</strong> @Model.Date.ToString("dd/MM/yyyy")</div>
                <div class="col-md-6"><strong>Trạng thái:</strong> <span class="badge bg-success">@Model.Status</span></div>
                <div class="col-md-6"><strong>Người đại diện:</strong> <span class="text-primary fw-bold">@Model.Tenant?.FullName</span></div>
                <div class="col-md-6"><strong>Phòng:</strong> <span class="badge bg-dark">@(detail?.Room?.RoomNumber ?? "N/A")</span></div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold">Danh sách cư dân lưu trú</h5>
        </div>
        
        <div class="card-body bg-white border-bottom py-3">
            <form asp-action="AddExistingTenant" method="post" class="row g-3 align-items-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="contractId" value="@Model.Id" />
                <input type="hidden" name="roomId" value="@(detail?.RoomId ?? 0)" />

                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text">Thêm cư dân:</span>
                        @* Ép kiểu rõ ràng thành SelectList để tránh lỗi key *@
                        @Html.DropDownList("tenantId", ViewBag.AvailableTenants as SelectList, "-- Chọn cư dân --", new { @class = "form-select", required = "required" })
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary fw-bold w-100">Xác nhận thêm</button>
                </div>
            </form>
        </div>

        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Họ và tên</th>
                        <th>Số điện thoại</th>
                        <th>Vai trò</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.Members is List<smart_hostel_management_system.Models.Core.TenantRoom> members && members.Any())
                    {
                        foreach (var item in members)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Tenant?.FullName</td>
                                <td>@item.Tenant?.Phone</td>
                                <td>
                                    <span class="badge @(item.IsRepresentative ? "bg-danger" : "bg-info")">
                                        @(item.IsRepresentative ? "Đại diện" : "Ở ghép")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" class="text-center py-3 text-muted">Chưa có thành viên nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 fw-bold">Sửa hợp đồng</a>
        <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Quay lại danh sách</a>
    </div>
</div>