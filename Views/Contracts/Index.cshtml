@model IEnumerable<Contract>
@{
    ViewData["Title"] = "Hop dong";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Hop dong</h1>
    <a class="btn btn-primary" asp-action="Create">Tao hop dong</a>
</div>
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" name="search" value="@ViewData["Search"]" placeholder="Tim so hop dong, phong, khach" />
    </div>
    <div class="col-md-3">
        <select class="form-select" name="status" asp-items="Html.GetEnumSelectList<ContractStatus>()">
            <option value="">Tat ca trang thai</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-primary w-100" type="submit">Loc</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>So HD</th>
            <th>Phong</th>
            <th>Khach thue</th>
            <th>Thoi han</th>
            <th>Gia thang</th>
            <th>Trang thai</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var contract in Model)
    {
        <tr>
            <td>@contract.ContractNumber</td>
            <td>@contract.Room?.Code</td>
            <td>@contract.Tenant?.FullName</td>
            <td>@contract.StartDate.ToString("dd/MM/yyyy") - @contract.EndDate.ToString("dd/MM/yyyy")</td>
            <td>@contract.MonthlyPrice.ToString("N0")</td>
            <td>
                <span class="badge @(contract.Status == ContractStatus.ExpiringSoon ? "bg-warning text-dark" : "bg-secondary")">@contract.Status</span>
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@contract.Id">Chi tiet</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@contract.Id">Sua</a>
                <form asp-action="Delete" asp-route-id="@contract.Id" method="post" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xoa hop dong nay?')">Xoa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
