@model smart_hostel_management_system.Models.ViewModels.ContractFormViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Tạo hợp đồng mới" : "Chỉnh sửa hợp đồng";
}

<h3 class="fw-bold mb-4">@ViewData["Title"]</h3>

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3 fw-bold" })

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Mã hợp đồng</label>
            @if (Model.Id == 0)
            {
                <input type="text" name="ContractNumber" value="AUTO" class="form-control text-secondary" readonly style="background-color: #e9ecef;" />
                <small class="text-muted d-block mt-1">Mã số thực tế sẽ tự sinh khi lưu thành công.</small>
            }
            else
            {
                <input type="text" name="ContractNumber" value="@Model.ContractNumber" class="form-control" readonly style="background-color: #e9ecef;" />
            }
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Ngày lập hợp đồng</label>
            <input type="date" name="Date" value="@(Model.Date.ToString("yyyy-MM-dd"))" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Cư dân đại diện</label>
            @Html.DropDownListFor(m => m.TenantId, ViewBag.Tenants as SelectList, "-- Chọn cư dân đại diện --", new { @class = "form-select", @required = "required" })
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Chọn phòng trọ</label>
            @Html.DropDownListFor(m => m.RoomId, ViewBag.Rooms as SelectList, "-- Chọn phòng trọ --", new { @class = "form-select", @required = "required" })
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Ngày bắt đầu</label>
            <input type="date" name="StartDate" value="@(Model.StartDate.ToString("yyyy-MM-dd"))" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Ngày hết hạn</label>
            <input type="date" name="EndDate" value="@(Model.EndDate.ToString("yyyy-MM-dd"))" class="form-control" required />
        </div>

        <div class="col-md-12 mb-3">
            <label class="form-label fw-bold">Trạng thái hợp đồng</label>
            @Html.DropDownListFor(m => m.Status, Html.GetEnumSelectList<smart_hostel_management_system.Models.Enums.ContractStatus>(), new { @class = "form-select" })
        </div>

        <div class="col-12 mb-3">
            <label class="form-label fw-bold">Quy định & Điều khoản</label>
            <textarea name="Content" class="form-control" rows="3">@Model.Content</textarea>
        </div>
    </div>

    @* PHẦN CHỌN DỊCH VỤ *@
    <div class="col-12 mb-4">
        <label class="form-label fw-bold">Dịch vụ đi kèm</label>
        <div class="card p-3 shadow-sm bg-light">
            <div class="row">
                @foreach (var s in (List<smart_hostel_management_system.Models.Core.Service>)ViewBag.AllServices)
                {
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedServiceIds" value="@s.Id" id="s_@s.Id"
                                   @(Model.SelectedServiceIds.Contains(s.Id) ? "checked" : "")>
                            <label class="form-check-label" for="s_@s.Id">
                                @s.Name <span class="text-muted small">(@s.Price.ToString("N0") VNĐ)</span>
                            </label>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary px-4">Lưu hợp đồng</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</form>