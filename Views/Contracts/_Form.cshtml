@model smart_hostel_management_system.Models.ViewModels.ContractFormViewModel
@using smart_hostel_management_system.Models.Enums

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="ContractNumber" class="form-label">Mã hợp đồng</label>
        <input asp-for="ContractNumber" type="hidden" />
        <input value="@(Model.Id == 0 ? "Tự động khi lưu" : Model.ContractNumber)" class="form-control" readonly />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Date" class="form-label">Ngày lập</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="TenantId" class="form-label">Cư dân</label>
        <select asp-for="TenantId" asp-items="ViewBag.Tenants" class="form-select">
            <option value="">-- Chọn cư dân --</option>
        </select>
        <span asp-validation-for="TenantId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="RoomId" class="form-label">Phòng</label>
        <select asp-for="RoomId" asp-items="ViewBag.Rooms" class="form-select">
            <option value="">-- Chọn phòng --</option>
        </select>
        <span asp-validation-for="RoomId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Status" class="form-label">Trạng thái</label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatus>()" class="form-select"></select>
    </div>
    <div class="col-12 mb-3">
        <label asp-for="Content" class="form-label">Điều khoản/Nội dung</label>
        <textarea asp-for="Content" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-12 mb-3">
        <label asp-for="Note" class="form-label">Ghi chú</label>
        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
    </div>
</div>
