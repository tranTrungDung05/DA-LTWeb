<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Panel Admin - Quản Lý Hóa Đơn</title>
    <style>
        .hd-container { max-width: 900px; margin: 30px auto; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .hd-title { color: #c0392b; border-bottom: 3px solid #c0392b; padding-bottom: 10px; margin-bottom: 20px; }
        
        /* Form nhập liệu */
        .form-box { background: #fff; border: 1px solid #e74c3c; padding: 20px; border-radius: 6px; margin-bottom: 25px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .form-grid { display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end; }
        .form-group { display: flex; flex-direction: column; gap: 5px; }
        .form-group label { font-size: 12px; font-weight: bold; color: #2c3e50; }
        .form-control { padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }
        
        /* Bảng danh sách */
        .hd-table { width: 100%; border-collapse: collapse; background: white; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .hd-table th, .hd-table td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        .hd-table th { background-color: #f8f9fa; color: #2c3e50; }
        .status-chua-thanh-toan { color: #e74c3c; font-weight: bold; }
        
        .btn-hd { border: none; padding: 10px 20px; cursor: pointer; border-radius: 4px; font-weight: bold; transition: 0.2s; }
        .btn-success { background-color: #2ecc71; color: white; }
    </style>
</head>
<body>

<div class="hd-container">
    <h1 class="hd-title">👑 PANEL ADMIN - QUẢN LÝ HÓA ĐƠN TRỌ</h1>
    <p style="color: #7f8c8d; font-style: italic;">Chủ trọ chốt số, nhập tay tiền dịch vụ từng phòng và ấn phát hành (Public) xuống cho khách thuê.</p>
    
    <div class="form-box">
        <h4 style="margin-top:0; color: #c0392b; margin-bottom: 15px;">✍️ CHỐT SỐ & NHẬP TIỀN DỊCH VỤ</h4>
        <form id="invoiceForm" onsubmit="publicInvoice(event)" class="form-grid">
            <div class="form-group">
                <label>Chọn Phòng:</label>
                <select id="txtRoomId" class="form-control" style="width: 130px;">
                    <option value="101">Phòng P101</option>
                    <option value="102">Phòng P102</option>
                    <option value="103">Phòng P103</option>
                </select>
            </div>
            <div class="form-group">
                <label>Tháng/Năm:</label>
                <input type="text" id="txtMonthYear" value="06/2026" class="form-control" style="width: 90px; text-align:center;" readonly>
            </div>
            <div class="form-group">
                <label>⚡ Tiền Điện (đ):</label>
                <input type="number" id="txtElectricity" value="150000" required class="form-control" style="width: 120px;">
            </div>
            <div class="form-group">
                <label>💧 Tiền Nước (đ):</label>
                <input type="number" id="txtWater" value="50000" required class="form-control" style="width: 120px;">
            </div>
            <div class="form-group">
                <label>🗑️ Tiền Rác (đ):</label>
                <input type="number" id="txtTrash" value="20000" required class="form-control" style="width: 120px;">
            </div>
            <button type="submit" class="btn-hd btn-success">⚡ Chốt & Public</button>
        </form>
    </div>

    <h3 style="color: #2c3e50;">📌 Danh sách hóa đơn chưa thanh toán (Mọi phòng)</h3>
    <table class="hd-table">
        <thead>
            <tr>
                <th>Mã Phòng</th>
                <th>Tên Khách Thuê</th>
                <th>Email Khách Liên Hệ</th>
                <th>Tổng Tiền Nợ</th>
                <th>Trạng Thái</th>
            </tr>
        </thead>
        <tbody id="adminTableBody">
            </tbody>
    </table>
</div>

<script>
    // Khởi tạo bộ dữ liệu gốc ban đầu nếu chưa có trong bộ nhớ trình duyệt
    if (!localStorage.getItem('sharedInvoices')) {
        const defaultData = [
            { id: 1, month: 6, year: 2026, roomId: 101, roomCode: "P101", tenantName: "Nguyen Van Thang", email: "thangnguyen@gmail.com", roomPrice: 3500000, electricityPrice: 180000, waterPrice: 60000, trashPrice: 20000, total: 3760000, status: "ChuaThanhToan" },
            { id: 2, month: 5, year: 2026, roomId: 101, roomCode: "P101", tenantName: "Nguyen Van Thang", email: "thangnguyen@gmail.com", roomPrice: 3500000, electricityPrice: 150000, waterPrice: 50000, trashPrice: 20000, total: 3720000, status: "DaThanhToan" }
        ];
        localStorage.setItem('sharedInvoices', JSON.stringify(defaultData));
    }

    document.addEventListener("DOMContentLoaded", loadAdminTable);

    function loadAdminTable() {
        const tbody = document.getElementById('adminTableBody');
        tbody.innerHTML = '';
        
        const db = JSON.parse(localStorage.getItem('sharedInvoices'));
        // Chỉ hiện những hóa đơn nào CHƯA THANH TOÁN của tất cả mọi user
        const unPaidList = db.filter(x => x.status === "ChuaThanhToan");

        unPaidList.forEach(item => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${item.roomCode}</strong></td>
                <td>${item.tenantName}</td>
                <td>${item.email}</td>
                <td class="status-chua-thanh-toan">${item.total.toLocaleString()}đ</td>
                <td><span class="status-chua-thanh-toan">Chưa Thanh Toán</span></td>
            `;
            tbody.appendChild(tr);
        });
    }

    // Xử lý sự kiện khi ấn nút Public gửi dữ liệu lên Backend và đồng bộ Frontend
    async function publicInvoice(event) {
        event.preventDefault();

        const roomId = parseInt(document.getElementById('txtRoomId').value);
        const electricity = parseInt(document.getElementById('txtElectricity').value);
        const water = parseInt(document.getElementById('txtWater').value);
        const trash = parseInt(document.getElementById('txtTrash').value);

        let basePrice = roomId === 101 ? 3500000 : (roomId === 102 ? 4000000 : 3800000);
        let tenantName = roomId === 101 ? "Nguyen Van Thang" : (roomId === 102 ? "Tran Dinh Hieu" : "Le Hoang Long");
        let email = roomId === 101 ? "thangnguyen@gmail.com" : (roomId === 102 ? "hieutranmomm@gmail.com" : "longle@gmail.com");
        let total = basePrice + electricity + water + trash;

        const bodyData = {
            roomId: roomId,
            roomPrice: basePrice,
            electricityPrice: electricity,
            waterPrice: water,
            trashPrice: trash,
            month: 6,
            year: 2026
        };

        try {
            // Gửi dữ liệu nhập tay sang đúng API [HttpPost("public-hoa-don")] ở Controller
            const response = await fetch('/api/HoaDon/public-hoa-don', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(bodyData)
            });
            const resResult = await response.json();

            // Đồng bộ dữ liệu giả lập lưu vào LocalStorage để test UI
            const db = JSON.parse(localStorage.getItem('sharedInvoices'));
            db.unshift({
                id: db.length + 1, month: 6, year: 2026, roomId: roomId, roomCode: "P" + roomId,
                tenantName: tenantName, email: email, roomPrice: basePrice,
                electricityPrice: electricity, waterPrice: water, trashPrice: trash,
                total: total, status: "ChuaThanhToan"
            });
            localStorage.setItem('sharedInvoices', JSON.stringify(db));

            alert(resResult.message);
            loadAdminTable(); // Nạp lại bảng Admin tại chỗ
            document.getElementById('invoiceForm').reset();
        } catch (error) {
            console.error("Lỗi kết nối API:", error);
        }
    }
</script>
</body>
</html>