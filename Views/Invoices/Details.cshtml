@model IEnumerable<smart_hostel_management_system.Models.Core.Invoice>

<h2>Hóa đơn của tôi</h2>
<table class="table">
    <thead><tr><th>Tháng</th><th>Tổng tiền</th><th>Trạng thái</th><th>Chi tiết</th></tr></thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.Month/@item.Year</td>
                <td>@item.TotalAmount.ToString("N0") đ</td>
                <td>@item.Status</td>
                <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Xem chi tiết</a></td>
            </tr>
        }
    </tbody>
</table>