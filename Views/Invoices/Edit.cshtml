@model smart_hostel_management_system.Models.ViewModels.InvoiceEditViewModel

<h2>Sửa hóa đơn: @Model.InvoiceNumber</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <table class="table">
        <thead><tr><th>Dịch vụ</th><th>Số lượng</th><th>Đơn giá</th></tr></thead>
        <tbody>
            @for (int i = 0; i < Model.Services.Count; i++) {
                <tr>
                    <td>@Model.Services[i].ServiceName</td>
                    <td>
                        <input type="hidden" asp-for="Services[i].ServiceId" />
                        <input type="number" step="0.1" asp-for="Services[i].Quantity" class="form-control" />
                    </td>
                    <td><input type="number" asp-for="Services[i].UnitPrice" class="form-control" /></td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" class="btn btn-success">Cập nhật hóa đơn</button>
</form>