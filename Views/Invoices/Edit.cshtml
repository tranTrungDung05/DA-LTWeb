@model smart_hostel_management_system.Models.ViewModels.InvoiceEditViewModel
@{
    ViewData["Title"] = "Nhập tiền dịch vụ";
}

<h2>Nhập tiền dịch vụ</h2>
<p>Hóa đơn <strong>@Model.InvoiceNumber</strong> · @Model.TenantName · Phòng @Model.RoomNumber</p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row mb-3">
        <div class="col-md-8">
            <label asp-for="MainContent" class="form-label">Nội dung</label>
            <input asp-for="MainContent" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="DueDate" class="form-label">Hạn thanh toán</label>
            <input asp-for="DueDate" type="date" class="form-control" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Dịch vụ</th>
                    <th>Đơn vị</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Services.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.Services[i].ServiceName
                            <input asp-for="Services[i].ServiceId" type="hidden" />
                        </td>
                        <td>
                            @Model.Services[i].Unit
                            <input asp-for="Services[i].Unit" type="hidden" />
                        </td>
                        <td><input asp-for="Services[i].Quantity" type="number" min="0" step="0.01" class="form-control" /></td>
                        <td><input asp-for="Services[i].UnitPrice" type="number" min="0" step="0.01" class="form-control" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="submit" class="btn btn-primary">Lưu tiền dịch vụ</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
