@model smart_hostel_management_system.Models.Core.Notification
@{
    ViewData["Title"] = "Gửi Thông Báo Mới";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="mb-0 fw-bold">🔔 Gửi Thông Báo Mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary">Tiêu đề thông báo <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Nhắc nhở đóng tiền điện nước tháng 6" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary">Nội dung chi tiết <span class="text-danger">*</span></label>
                            <textarea asp-for="Content" class="form-control" rows="5" placeholder="Nhập nội dung thông báo chi tiết..." required></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">⬅️ Hủy & Quay Lại</a>
                            <button type="submit" class="btn btn-primary px-4 py-2 shadow-sm">🚀 Gửi Thông Báo</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
