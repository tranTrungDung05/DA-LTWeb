@model Property
@{
    ViewData["Title"] = "Sua nha tro";
}

<h1 class="h3 mb-3">Sua nha tro</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
    <input type="hidden" asp-for="Id" />
    <partial name="_PropertyForm" model="Model" />
    <div class="col-12">
        <button class="btn btn-primary" type="submit">Luu</button>
        <a class="btn btn-link" asp-action="Index">Quay lai</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
