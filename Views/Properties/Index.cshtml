@model IEnumerable<Property>
@{
    ViewData["Title"] = "Nha tro";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Nha tro / Khu tro</h1>
    <a class="btn btn-primary" asp-action="Create">Them nha tro</a>
</div>
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Ten</th>
            <th>Dia chi</th>
            <th>Dien thoai</th>
            <th>So phong</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var property in Model)
    {
        <tr>
            <td>@property.Name</td>
            <td>@property.Address</td>
            <td>@property.PhoneNumber</td>
            <td>@property.Rooms.Count</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@property.Id">Sua</a>
                <form asp-action="Delete" asp-route-id="@property.Id" method="post" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xoa nha tro nay?')">Xoa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
