@using smart_hostel_management_system.Models.Enums
@model IEnumerable<smart_hostel_management_system.Models.Core.Room>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-dark fw-bold">🏠 Quản Lý Danh Sách Phòng Trọ</h2>
            <p class="text-muted mb-0">Quản lý không gian vật lý và thành viên từng phòng</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm">+ Thêm Phòng Mới</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Số Phòng</th>
                        <th>Diện Tích</th>
                        <th>Giá Thuê / Tháng</th>
                        <th>Sức Chứa Tối Đa</th>
                        <th>Trạng Thái</th>
                        <th class="text-center pe-4">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark fs-5">@item.RoomNumber</td>
                            <td>@item.Area m²</td>
                            <td class="fw-bold text-danger">@item.MonthlyPrice.ToString("N0") đ</td>
                            <td>@item.MaxOccupants Người</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case RoomStatus.Available:
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 border border-success border-opacity-25 rounded-pill">🟢 Còn Trống</span>
                                        break;
                                    case RoomStatus.Occupied:
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 border border-danger border-opacity-25 rounded-pill">🔴 Đang Ở</span>
                                        break;
                                    case RoomStatus.Maintenance:
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 border border-warning border-opacity-25 rounded-pill text-dark">🟡 Bảo Trì</span>
                                        break;
                                    case RoomStatus.Locked:
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 border border-secondary border-opacity-25 rounded-pill">⚫ Đã Khóa</span>
                                        break;
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white px-3">👤 Thành viên</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning px-3">Sửa</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa phòng này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-3">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>