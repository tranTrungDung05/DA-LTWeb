@model Room
@{
    ViewData["Title"] = "Them phong";
}

<h1 class="h3 mb-3">Them phong</h1>
<form asp-action="Create" method="post" class="row g-3">
    <partial name="_RoomForm" model="Model" />
    <div class="col-12">
        <button class="btn btn-primary" type="submit">Luu</button>
        <a class="btn btn-link" asp-action="Index">Quay lai</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
