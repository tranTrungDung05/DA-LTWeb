@model IEnumerable<Room>
@{
    ViewData["Title"] = "Phong tro";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Phong tro</h1>
    <a class="btn btn-primary" asp-action="Create">Them phong</a>
</div>
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" name="search" value="@ViewData["Search"]" placeholder="Tim ma phong, ghi chu" />
    </div>
    <div class="col-md-3">
        <select class="form-select" name="status" asp-items="Html.GetEnumSelectList<RoomStatus>()">
            <option value="">Tat ca trang thai</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-primary w-100" type="submit">Loc</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Ma phong</th>
            <th>Nha tro</th>
            <th>Dien tich</th>
            <th>Gia thang</th>
            <th>Trang thai</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var room in Model)
    {
        <tr>
            <td>@room.Code</td>
            <td>@room.Property?.Name</td>
            <td>@room.Area m2</td>
            <td>@room.MonthlyPrice.ToString("N0")</td>
            <td><span class="badge bg-secondary">@room.Status</span></td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@room.Id">Chi tiet</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@room.Id">Sua</a>
                <form asp-action="Delete" asp-route-id="@room.Id" method="post" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xoa phong nay?')">Xoa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
