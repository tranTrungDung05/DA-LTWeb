@model smart_hostel_management_system.Models.Core.Service
@{
    ViewData["Title"] = "Xác nhận xóa dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Xác nhận xóa dịch vụ</h2>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<div class="card border-danger shadow-sm">
    <div class="card-header bg-danger text-white">
        ⚠️ Bạn có chắc muốn xóa dịch vụ này?
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Tên dịch vụ</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Đơn vị tính</dt>
            <dd class="col-sm-9">@Model.Unit</dd>

            <dt class="col-sm-3">Đơn giá</dt>
            <dd class="col-sm-9">@Model.Price.ToString("N0") VNĐ</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <dt class="col-sm-3">Mô tả</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            }
        </dl>
        <p class="text-danger fw-bold">Dịch vụ sẽ bị xóa vĩnh viễn. Thao tác này không thể hoàn tác.</p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">🗑️ Xác nhận xóa</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
