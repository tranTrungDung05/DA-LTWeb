@{
    var isLandingPage = ViewData["IsLandingPage"] as bool? ?? false;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
    var currentSection = currentController switch
    {
        "Admin" => "Bảng điều khiển",
        "Room" => "Quản lý phòng",
        "Tenants" => "Quản lý cư dân",
        "Contracts" => "Quản lý hợp đồng",
        "Services" => "Quản lý dịch vụ",
        "Notifications" => "Hệ thống thông báo",
        "Invoices" => isAdmin ? "Quản lý hóa đơn" : "Hóa đơn của tôi",
        "Payments" => "Giao dịch và thanh toán",
        _ => "Smart Hostel"
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Hostel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!isLandingPage)
    {
        <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/smart_hostel_management_system.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isLandingPage ? ViewData["BodyClass"] : "app-page")">
    @if (isLandingPage)
    {
        <div class="landing-shell">
            <main role="main">@RenderBody()</main>
        </div>
    }
    else
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <a class="app-brand" asp-controller="Home" asp-action="Index">
                    <span class="app-brand__mark" aria-hidden="true">
                        <svg viewBox="0 0 32 32">
                            <path d="M5 15.2 16 6l11 9.2v11.3a1.5 1.5 0 0 1-1.5 1.5h-19A1.5 1.5 0 0 1 5 26.5V15.2Z" />
                            <path d="M12.2 28v-8.2h7.6V28M10.5 14.7h11" />
                        </svg>
                    </span>
                    <span><strong>Smart Hostel</strong><small>@(isAdmin ? "Không gian quản trị" : "Cổng cư dân")</small></span>
                </a>

                <nav class="app-nav" aria-label="Điều hướng hệ thống">
                    @if (isAdmin)
                    {
                        <span class="app-nav__label">Tổng quan</span>
                        <a class="@(currentController == "Admin" ? "is-active" : "")" asp-controller="Admin" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm10 7h6V11h-6v9ZM4 20h6v-3H4v3Zm10-13h6V4h-6v3Z" /></svg>
                            Bảng điều khiển
                        </a>
                        <span class="app-nav__label">Vận hành</span>
                        <a class="@(currentController == "Room" ? "is-active" : "")" asp-controller="Room" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20H4v-9.5ZM9 20v-6h6v6" /></svg>
                            Phòng
                        </a>
                        <a class="@(currentController == "Tenants" ? "is-active" : "")" asp-controller="Tenants" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M16 20v-1.5c0-2-1.8-3.5-4-3.5s-4 1.5-4 3.5V20M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM18 9h4M20 7v4" /></svg>
                            Cư dân
                        </a>
                        <a class="@(currentController == "Contracts" ? "is-active" : "")" asp-controller="Contracts" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M5 3h11l3 3v15H5V3Zm11 0v4h3M8 11h8M8 15h8" /></svg>
                            Hợp đồng
                        </a>
                        <a class="@(currentController == "Services" ? "is-active" : "")" asp-controller="Services" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
                            Dịch vụ
                        </a>
                        <a class="@(currentController == "Notifications" ? "is-active" : "")" asp-controller="Notifications" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 0 0-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" /></svg>
                            Thông báo
                        </a>
                        <span class="app-nav__label">Tài chính</span>
                        <a class="@(currentController == "Invoices" ? "is-active" : "")" asp-controller="Invoices" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Zm3 5h6M9 12h6" /></svg>
                            Hóa đơn
                        </a>
                        <a class="@(currentController == "Payments" ? "is-active" : "")" asp-controller="Payments" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M3 6h18v12H3V6Zm0 4h18M7 15h4" /></svg>
                            Giao dịch
                        </a>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="app-nav__label">Cá nhân</span>
                        <a class="@(currentController == "Invoices" || currentController == "Payments" ? "is-active" : "")" asp-controller="Invoices" asp-action="MyInvoices">
                            <svg viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Zm3 5h6M9 12h6" /></svg>
                            Hóa đơn của tôi
                        </a>
                    }
                    else
                    {
                        <a class="@(currentController == "Home" ? "is-active" : "")" asp-controller="Home" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20H4v-9.5ZM9 20v-6h6v6" /></svg>
                            Trang chủ
                        </a>
                        <a asp-controller="Account" asp-action="Login">
                            <svg viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3M14 4h6v16h-6" /></svg>
                            Đăng nhập
                        </a>
                    }
                </nav>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="app-sidebar__account">
                        <span class="app-avatar">@(User.Identity.Name?.Substring(0, 1).ToUpperInvariant())</span>
                        <span><strong>@User.Identity.Name</strong><small>@(isAdmin ? "Quản trị viên" : "Cư dân")</small></span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" aria-label="Đăng xuất" title="Đăng xuất">
                                <svg viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3M14 4h6v16h-6" /></svg>
                            </button>
                        </form>
                    </div>
                }
            </aside>

            <div class="app-main">
                <header class="app-topbar">
                    <div>
                        <span class="app-topbar__eyebrow">SMART HOSTEL</span>
                        <strong>@(ViewData["Title"] ?? currentSection)</strong>
                    </div>
                    <div class="app-topbar__actions">
                        <a asp-controller="Home" asp-action="Index" title="Về trang giới thiệu" aria-label="Về trang giới thiệu">
                            <svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20H4v-9.5ZM9 20v-6h6v6" /></svg>
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (isAdmin)
                            {
                                <a asp-controller="Notifications" asp-action="Index" class="position-relative me-3 text-dark text-decoration-none">
                                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                        <span class="visually-hidden">Thông báo mới</span>
                                    </span>
                                </a>
                            }
                            <span class="app-topbar__user"><i></i>Xin chào, <strong>@User.Identity.Name</strong></span>
                        }
                    </div>
                </header>
                <main class="app-content" role="main">
                    @RenderBody()
                </main>
                <footer class="app-footer">© 2026 Smart Hostel · Vận hành rõ ràng, nhẹ nhàng hơn.</footer>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
