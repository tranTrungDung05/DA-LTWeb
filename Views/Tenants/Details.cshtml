@model Tenant
@{
    ViewData["Title"] = "Chi tiet khach thue";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.FullName</h1>
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Sua khach thue</a>
</div>
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Dien thoai</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">CCCD/CMND</dt>
    <dd class="col-sm-9">@Model.IdentityNumber</dd>
    <dt class="col-sm-3">Trang thai</dt>
    <dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Giay to</dt>
    <dd class="col-sm-9">
        @if (!string.IsNullOrWhiteSpace(Model.DocumentPath))
        {
            <a href="@Model.DocumentPath" target="_blank">Xem file</a>
        }
    </dd>
</dl>

<h2 class="h5 mt-4">Gan khach vao phong</h2>
<form asp-action="AssignRoom" method="post" class="row g-2 mb-3">
    <input type="hidden" name="tenantId" value="@Model.Id" />
    <div class="col-md-4"><select name="roomId" asp-items="ViewBag.RoomId" class="form-select"></select></div>
    <div class="col-md-3"><input name="moveInDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Gan phong</button></div>
</form>

<h2 class="h5 mt-4">Lich su thue</h2>
<table class="table table-sm">
    <thead><tr><th>Phong</th><th>Ngay vao</th><th>Ngay ra</th><th>Hien tai</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model.TenantRooms.OrderByDescending(item => item.MoveInDate))
    {
        <tr>
            <td>@item.Room?.Code</td>
            <td>@item.MoveInDate.ToString("dd/MM/yyyy")</td>
            <td>@item.MoveOutDate?.ToString("dd/MM/yyyy")</td>
            <td>@(item.IsCurrent ? "Co" : "Khong")</td>
            <td class="text-end">
                @if (item.IsCurrent)
                {
                    <form asp-action="LeaveRoom" method="post">
                        <input type="hidden" name="tenantRoomId" value="@item.Id" />
                        <input type="hidden" name="tenantId" value="@Model.Id" />
                        <button class="btn btn-sm btn-outline-warning" type="submit">Roi phong</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
