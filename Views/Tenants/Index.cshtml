@model IEnumerable<Tenant>
@{
    ViewData["Title"] = "Khach thue";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Khach thue</h1>
    <a class="btn btn-primary" asp-action="Create">Them khach thue</a>
</div>
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" name="search" value="@ViewData["Search"]" placeholder="Tim ten, so dien thoai, CCCD" />
    </div>
    <div class="col-md-3">
        <select class="form-select" name="status" asp-items="Html.GetEnumSelectList<TenantStatus>()">
            <option value="">Tat ca trang thai</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-primary w-100" type="submit">Loc</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Ho ten</th>
            <th>Dien thoai</th>
            <th>Phong hien tai</th>
            <th>Trang thai</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var tenant in Model)
    {
        var currentRoom = tenant.TenantRooms.FirstOrDefault(item => item.IsCurrent)?.Room?.Code;
        <tr>
            <td>@tenant.FullName</td>
            <td>@tenant.PhoneNumber</td>
            <td>@currentRoom</td>
            <td><span class="badge bg-secondary">@tenant.Status</span></td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@tenant.Id">Chi tiet</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@tenant.Id">Sua</a>
                <form asp-action="Delete" asp-route-id="@tenant.Id" method="post" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xoa khach thue nay?')">Xoa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
